# Preset por defecto para Docker: stack completo (easyocr + paddleocr + llm).
# Para menos memoria, poné ENABLE_PADDLEOCR=0 y/o ENABLE_LLM=0.
ENABLE_EASYOCR=1
ENABLE_PADDLEOCR=1
ENABLE_LLM=1
ENABLE_GEOCODING=1
REJECT_ON_MISSING=0

# Precarga de modelos al arrancar (docker-compose ya lo activa con WARMUP=1)
WARMUP=0

# LLM (servido por Ollama; el compose descarga el modelo automáticamente)
LLM_MODEL=qwen2.5:3b

# Geocoding
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_EMAIL=tu-email@ejemplo.com

# Auth (vacío = abierto)
API_TOKEN=

# Debug
DEBUG_DIR=./data/debug
DEBUG_RETENTION_DAYS=7
